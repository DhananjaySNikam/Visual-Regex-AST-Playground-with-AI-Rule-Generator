# ---- Optional: free AI providers -------------------------------------------
# With neither key set the backend uses its deterministic Local Rule Compiler
# (zero network, zero cost, instant). Add a key to route prompts to a model.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Backend ---------------------------------------------------------------
PORT=8787
HOST=0.0.0.0
SQLITE_PATH=playground.sqlite
# node:sqlite is still flagged in Node 22; the server enables it via NODE_OPTIONS
NODE_OPTIONS=--experimental-sqlite
